{
  "name": "definy",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:seeds && vite",
    "mcp": "node mcp/server.ts",
    "build": "npm run build:seeds && vite build",
    "build:seeds": "node scripts/generate_seed_bundle.ts",
    "export:seeds": "node scripts/export_seeds.ts",
    "build:schema": "node scripts/generate_seed_schema.ts",
    "build:stage1": "node scripts/regenerate_stage1.ts",
    "check:stage1": "node scripts/regenerate_stage1.ts --check",
    "deploy": "void deploy --platform cloudflare",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "^1.6.2",
    "ag-psd": "^34.1.0",
    "oxlint": "^1.91.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "void": "^1.6.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.2"
    }
  }
}
