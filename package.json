{
  "name": "definy",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:seeds",
    "build:seeds": "node scripts/generate_seed_bundle.ts",
    "export:store": "node scripts/export_store.ts",
    "build:schema": "node scripts/generate_seed_schema.ts",
    "build:stage1": "node scripts/regenerate_stage1.ts",
    "check:stage1": "node scripts/regenerate_stage1.ts --check",
    "deploy": "npm run build && wrangler deploy",
    "serve": "node cli/definy.ts serve",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.161.0"
  }
}
