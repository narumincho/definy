{
  "name": "definy",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:seeds && vite",
    "build": "npm run build:seeds && vite build",
    "build:seeds": "node scripts/generate_seed_bundle.ts",
    "export:seeds": "node scripts/export_seeds.ts",
    "build:stage1": "node scripts/regenerate_stage1.ts",
    "check:stage1": "node scripts/regenerate_stage1.ts --check",
    "deploy": "npm run build && npx wrangler deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "fmt": "prettier --write ."
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@void/react": "^1.1.11",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "void": "^1.1.11"
  }
}
