{
  "problemMatcher": [
    {
      "owner": "rust-short",
      "pattern": [
        {
          "regexp": "^([^\\s:]+\\.rs):(\\d+):(\\d+): (error|warning)(?:\\[\\S+\\])?: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "rust-panic",
      "pattern": [
        {
          "regexp": "^thread '(.*)' \\(?\\d*\\)? ?panicked at ([^:]+):(\\d+):(\\d+):$",
          "code": 1,
          "file": 2,
          "line": 3,
          "column": 4
        },
        {
          "regexp": "^(.+)$",
          "message": 1
        }
      ]
    }
  ]
}
