{
  "$schema": "./schemas/module-seed.schema.json",
  "module_name": "wasi",
  "module_description": [
    {
      "language": "en",
      "text": "WASI 0.3 capabilities (Clocks, Random, I/O) for capability-based DI"
    },
    {
      "language": "ja",
      "text": "WASI 0.3 能力インターフェース (時計・乱数・I/O) と能力注入基盤"
    }
  ],
  "message": "式とパーツの型の保存形式を core.expression / core.type-ast の値 ({\"#tag\": payload}) にする",
  "parts": [
    {
      "name": "wasi.datetime",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "WASI 0.3 datetime record type with seconds and nanoseconds"
        },
        {
          "language": "ja",
          "text": "秒数とナノ秒数を持つ WASI 0.3 datetime レコード型"
        }
      ]
    },
    {
      "name": "wasi.wall-clock",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "WASI 0.3 wall-clock capability interface with now: () -> datetime"
        },
        {
          "language": "ja",
          "text": "現在日時を取得する now: () -> datetime を持つ WASI 0.3 wall-clock インターフェース型"
        }
      ]
    },
    {
      "name": "wasi.monotonic-clock",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "WASI 0.3 monotonic-clock capability interface with now: () -> number (nanoseconds)"
        },
        {
          "language": "ja",
          "text": "単調増加時間（ナノ秒）を取得する now: () -> number を持つ WASI 0.3 monotonic-clock インターフェース型"
        }
      ]
    },
    {
      "name": "wasi.random",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "WASI 0.3 random capability interface with get-random-u64: () -> number"
        },
        {
          "language": "ja",
          "text": "安全な64ビット乱数を取得する get-random-u64: () -> number を持つ WASI 0.3 random インターフェース型"
        }
      ]
    },
    {
      "name": "clock-now",
      "part_type": {
        "#function": {
          "parameters": [
            {
              "name": "clock",
              "type": {
                "#record": [
                  {
                    "key": "now",
                    "field_type": {
                      "#function": {
                        "parameters": [],
                        "return_type": {
                          "#record": [
                            {
                              "key": "seconds",
                              "field_type": {
                                "#number": null
                              }
                            },
                            {
                              "key": "nanoseconds",
                              "field_type": {
                                "#number": null
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "return_type": {
            "#record": [
              {
                "key": "seconds",
                "field_type": {
                  "#number": null
                }
              },
              {
                "key": "nanoseconds",
                "field_type": {
                  "#number": null
                }
              }
            ]
          }
        }
      },
      "description": [
        {
          "language": "en",
          "text": "Invoke now() on a WASI Wall Clock capability to get the current datetime"
        },
        {
          "language": "ja",
          "text": "WASI Wall Clock 能力の now() を呼び出して現在の日時を取得する関数"
        }
      ],
      "expression": {
        "#function": {
          "parameters": [
            {
              "parameter_id": 1,
              "parameter_name": "clock"
            }
          ],
          "body": {
            "#call": {
              "function": {
                "#record_get": {
                  "record": {
                    "#variable": {
                      "variable_id": 1
                    }
                  },
                  "key": "now"
                }
              },
              "arguments": []
            }
          }
        }
      }
    },
    {
      "name": "monotonic-now",
      "part_type": {
        "#function": {
          "parameters": [
            {
              "name": "clock",
              "type": {
                "#record": [
                  {
                    "key": "now",
                    "field_type": {
                      "#function": {
                        "parameters": [],
                        "return_type": {
                          "#number": null
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "return_type": {
            "#number": null
          }
        }
      },
      "description": [
        {
          "language": "en",
          "text": "Invoke now() on a WASI Monotonic Clock capability to get the monotonic timestamp in nanoseconds"
        },
        {
          "language": "ja",
          "text": "WASI Monotonic Clock 能力の now() を呼び出してナノ秒タイムスタンプを取得する関数"
        }
      ],
      "expression": {
        "#function": {
          "parameters": [
            {
              "parameter_id": 1,
              "parameter_name": "clock"
            }
          ],
          "body": {
            "#call": {
              "function": {
                "#record_get": {
                  "record": {
                    "#variable": {
                      "variable_id": 1
                    }
                  },
                  "key": "now"
                }
              },
              "arguments": []
            }
          }
        }
      }
    },
    {
      "name": "random-u64",
      "part_type": {
        "#function": {
          "parameters": [
            {
              "name": "random",
              "type": {
                "#record": [
                  {
                    "key": "get_random_u64",
                    "field_type": {
                      "#function": {
                        "parameters": [],
                        "return_type": {
                          "#number": null
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "return_type": {
            "#number": null
          }
        }
      },
      "description": [
        {
          "language": "en",
          "text": "Invoke get_random_u64() on a WASI Random capability to get a random 64-bit integer"
        },
        {
          "language": "ja",
          "text": "WASI Random 能力の get_random_u64() を呼び出して乱数を取得する関数"
        }
      ],
      "expression": {
        "#function": {
          "parameters": [
            {
              "parameter_id": 1,
              "parameter_name": "random"
            }
          ],
          "body": {
            "#call": {
              "function": {
                "#record_get": {
                  "record": {
                    "#variable": {
                      "variable_id": 1
                    }
                  },
                  "key": "get_random_u64"
                }
              },
              "arguments": []
            }
          }
        }
      }
    },
    {
      "name": "clock-get-seconds",
      "part_type": {
        "#function": {
          "parameters": [
            {
              "name": "clock",
              "type": {
                "#record": [
                  {
                    "key": "now",
                    "field_type": {
                      "#function": {
                        "parameters": [],
                        "return_type": {
                          "#record": [
                            {
                              "key": "seconds",
                              "field_type": {
                                "#number": null
                              }
                            },
                            {
                              "key": "nanoseconds",
                              "field_type": {
                                "#number": null
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            }
          ],
          "return_type": {
            "#number": null
          }
        }
      },
      "description": [
        {
          "language": "en",
          "text": "Invoke now() on a WASI Wall Clock capability and extract seconds"
        },
        {
          "language": "ja",
          "text": "WASI Wall Clock 能力の now() を呼び出して秒数を取得する関数"
        }
      ],
      "expression": {
        "#function": {
          "parameters": [
            {
              "parameter_id": 1,
              "parameter_name": "clock"
            }
          ],
          "body": {
            "#record_get": {
              "record": {
                "#call": {
                  "function": {
                    "#record_get": {
                      "record": {
                        "#variable": {
                          "variable_id": 1
                        }
                      },
                      "key": "now"
                    }
                  },
                  "arguments": []
                }
              },
              "key": "seconds"
            }
          }
        }
      }
    },
    {
      "name": "clock-is-expired",
      "part_type": {
        "#function": {
          "parameters": [
            {
              "name": "clock",
              "type": {
                "#record": [
                  {
                    "key": "now",
                    "field_type": {
                      "#function": {
                        "parameters": [],
                        "return_type": {
                          "#record": [
                            {
                              "key": "seconds",
                              "field_type": {
                                "#number": null
                              }
                            },
                            {
                              "key": "nanoseconds",
                              "field_type": {
                                "#number": null
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                ]
              }
            },
            {
              "name": "deadline",
              "type": {
                "#number": null
              }
            }
          ],
          "return_type": {
            "#boolean": null
          }
        }
      },
      "description": [
        {
          "language": "en",
          "text": "Check if the current WASI Clock time has reached or passed a deadline"
        },
        {
          "language": "ja",
          "text": "WASI Clock 能力から取得した現在時刻が期限に達しているかを判定する関数"
        }
      ],
      "expression": {
        "#function": {
          "parameters": [
            {
              "parameter_id": 1,
              "parameter_name": "clock"
            },
            {
              "parameter_id": 2,
              "parameter_name": "deadline"
            }
          ],
          "body": {
            "#call": {
              "function": {
                "#part_reference": {
                  "part_definition_event_hash": {
                    "$part": "core.greater-than-or-equal"
                  }
                }
              },
              "arguments": [
                {
                  "name": "left",
                  "value": {
                    "#record_get": {
                      "record": {
                        "#call": {
                          "function": {
                            "#record_get": {
                              "record": {
                                "#variable": {
                                  "variable_id": 1
                                }
                              },
                              "key": "now"
                            }
                          },
                          "arguments": []
                        }
                      },
                      "key": "seconds"
                    }
                  }
                },
                {
                  "name": "right",
                  "value": {
                    "#variable": {
                      "variable_id": 2
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "name": "outgoing-request",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "HTTP request to send, like wasi:http/types.outgoing-request (method, absolute URL, headers, body bytes). secret_headers are headers whose value is prefix followed by the value of the secret: the host puts the value just before sending, only to the URLs the user allowed for the secret, so the program never sees it"
        },
        {
          "language": "ja",
          "text": "送る HTTP リクエスト. wasi:http/types の outgoing-request に相当する (メソッド, 絶対 URL, ヘッダー, 本文のバイト列). secret_headers は値が prefix とシークレットの値をつなげたヘッダー. 値はホストが送信の直前に入れ, そのシークレットに利用者が許可した URL にだけ送るので, プログラムからは値が見えない"
        }
      ],
      "expression": {
        "#type_record": [
          {
            "key": "method",
            "value": {
              "#type_string": null
            }
          },
          {
            "key": "url",
            "value": {
              "#type_string": null
            }
          },
          {
            "key": "headers",
            "value": {
              "#type_list": {
                "item_type": {
                  "#type_record": [
                    {
                      "key": "name",
                      "value": {
                        "#type_string": null
                      }
                    },
                    {
                      "key": "value",
                      "value": {
                        "#type_string": null
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "key": "secret_headers",
            "value": {
              "#type_list": {
                "item_type": {
                  "#type_record": [
                    {
                      "key": "name",
                      "value": {
                        "#type_string": null
                      }
                    },
                    {
                      "key": "prefix",
                      "value": {
                        "#type_string": null
                      }
                    },
                    {
                      "key": "secret",
                      "value": {
                        "#type_secret": null
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "key": "body",
            "value": {
              "#type_list": {
                "item_type": {
                  "#type_number": null
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "incoming-response",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "Received HTTP response, like wasi:http/types.incoming-response. text is the body decoded as UTF-8"
        },
        {
          "language": "ja",
          "text": "受け取った HTTP レスポンス. wasi:http/types の incoming-response に相当する. text は本文を UTF-8 として読んだ文字列"
        }
      ],
      "expression": {
        "#type_record": [
          {
            "key": "status",
            "value": {
              "#type_number": null
            }
          },
          {
            "key": "headers",
            "value": {
              "#type_list": {
                "item_type": {
                  "#type_record": [
                    {
                      "key": "name",
                      "value": {
                        "#type_string": null
                      }
                    },
                    {
                      "key": "value",
                      "value": {
                        "#type_string": null
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "key": "body",
            "value": {
              "#type_list": {
                "item_type": {
                  "#type_number": null
                }
              }
            }
          },
          {
            "key": "text",
            "value": {
              "#type_string": null
            }
          }
        ]
      }
    },
    {
      "name": "http-result",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "Result of wasi:http/outgoing-handler.handle: the response, or an error message (network error, CORS error, ...)"
        },
        {
          "language": "ja",
          "text": "wasi:http/outgoing-handler の handle の結果. レスポンスか, エラーの説明 (ネットワークエラー, CORS エラーなど)"
        }
      ],
      "expression": {
        "#type_union": [
          {
            "tag": "ok",
            "payload_type": {
              "#some": {
                "#part_reference": {
                  "part_definition_event_hash": {
                    "$part": "wasi.incoming-response"
                  }
                }
              }
            }
          },
          {
            "tag": "error",
            "payload_type": {
              "#some": {
                "#type_string": null
              }
            }
          }
        ]
      }
    },
    {
      "name": "io",
      "part_type": {
        "#type": null
      },
      "description": [
        {
          "language": "en",
          "text": "A program that does I/O through the host, step by step: done(message) ends it, outgoing_request sends an HTTP request with the host fetch (wasi:http/outgoing-handler.handle) and continues with then(result), get_parts reads the latest expressions of the parts with the ids from the definy the runner uses (to compile quoted code, see core.code). Secrets such as API tokens are not read here: put them in secret_headers of the request"
        },
        {
          "language": "ja",
          "text": "ホストを通して 1 歩ずつ I/O をするプログラム. done(message) で終わり, outgoing_request はホストの fetch で HTTP リクエストを送って (wasi:http/outgoing-handler の handle) 結果を then に渡して続け, get_parts は実行している definy からその id のパーツの最新の式を読む (quote したコードをコンパイルするため. core.code を参照). API トークンなどのシークレットはここで読まず, リクエストの secret_headers に入れる"
        }
      ],
      "expression": {
        "#type_union": [
          {
            "tag": "done",
            "payload_type": {
              "#some": {
                "#type_string": null
              }
            }
          },
          {
            "tag": "outgoing_request",
            "payload_type": {
              "#some": {
                "#type_record": [
                  {
                    "key": "request",
                    "value": {
                      "#part_reference": {
                        "part_definition_event_hash": {
                          "$part": "wasi.outgoing-request"
                        }
                      }
                    }
                  },
                  {
                    "key": "then",
                    "value": {
                      "#type_function": {
                        "parameters": [
                          {
                            "name": "result",
                            "type": {
                              "#part_reference": {
                                "part_definition_event_hash": {
                                  "$part": "wasi.http-result"
                                }
                              }
                            }
                          }
                        ],
                        "return_type": {
                          "#part_reference": {
                            "part_definition_event_hash": {
                              "$part": "wasi.io"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "tag": "get_parts",
            "payload_type": {
              "#some": {
                "#type_record": [
                  {
                    "key": "ids",
                    "value": {
                      "#type_list": {
                        "item_type": {
                          "#type_string": null
                        }
                      }
                    }
                  },
                  {
                    "key": "then",
                    "value": {
                      "#type_function": {
                        "parameters": [
                          {
                            "name": "parts",
                            "type": {
                              "#type_list": {
                                "item_type": {
                                  "#type_record": [
                                    {
                                      "key": "id",
                                      "value": {
                                        "#type_string": null
                                      }
                                    },
                                    {
                                      "key": "expression",
                                      "value": {
                                        "#part_reference": {
                                          "part_definition_event_hash": {
                                            "$part": "core.expression"
                                          }
                                        }
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          }
                        ],
                        "return_type": {
                          "#part_reference": {
                            "part_definition_event_hash": {
                              "$part": "wasi.io"
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}