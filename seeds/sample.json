  "module_name": "sample",
  "module_description": [
    {
      "language": "en",
      "text": "Sample programs showcasing definy expressions and computations"
    },
    {
      "language": "ja",
      "text": "definy の計算式や機能を体験できるサンプルプログラム集"
    }
  ],
  "message": "Initial commit for sample module",
  "parts": [
    {
      "name": "triangle-area",
      "part_type": "number",
      "description": [
        {
          "language": "en",
          "text": "Calculate the area of a triangle (base 10, height 5)"
        },
        {
          "language": "ja",
          "text": "三角形の面積を計算するサンプルプログラム (底辺 10, 高さ 5)"
        }
      ],
      "expression": {
        "Let": {
          "variable_id": 1,
          "variable_name": "base",
          "value": {
            "Number": {
              "value": 10
            }
          },
          "body": {
            "Let": {
              "variable_id": 2,
              "variable_name": "height",
              "value": {
                "Number": {
                  "value": 5
                }
              },
              "body": {
                "Divide": {
                  "left": {
                    "Multiply": {
                      "left": {
                        "Variable": {
                          "variable_id": 1
                        }
                      },
                      "right": {
                        "Variable": {
                          "variable_id": 2
                        }
                      }
                    }
                  },
                  "right": {
                    "Number": {
                      "value": 2
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "greet",
      "part_type": "string",
      "description": [
        {
          "language": "en",
          "text": "Greeting message using string concatenation"
        },
        {
          "language": "ja",
          "text": "文字列結合を使った挨拶メッセージの生成サンプル"
        }
      ],
      "expression": {
        "StringConcat": {
          "left": {
            "String": {
              "value": "Hello, "
            }
          },
          "right": {
            "String": {
              "value": "definy!"
            }
          }
        }
      }
    },
    {
      "name": "is-even-sample",
      "part_type": "string",
      "description": [
        {
          "language": "en",
          "text": "Check if a number is even using conditional expression"
        },
        {
          "language": "ja",
          "text": "剰余算と条件分岐による偶数・奇数判定サンプル (n = 4)"
        }
      ],
      "expression": {
        "Let": {
          "variable_id": 1,
          "variable_name": "n",
          "value": {
            "Number": {
              "value": 4
            }
          },
          "body": {
            "If": {
              "condition": {
                "Equal": {
                  "left": {
                    "Remainder": {
                      "left": {
                        "Variable": {
                          "variable_id": 1
                        }
                      },
                      "right": {
                        "Number": {
                          "value": 2
                        }
                      }
                    }
                  },
                  "right": {
                    "Number": {
                      "value": 0
                    }
                  }
                }
              },
              "then_expr": {
                "String": {
                  "value": "even"
                }
              },
              "else_expr": {
                "String": {
                  "value": "odd"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "prime-numbers",
      "part_type": {
        "list": "number"
      },
      "description": [
        {
          "language": "en",
          "text": "List literal containing prime numbers"
        },
        {
          "language": "ja",
          "text": "素数のリストリテラルサンプル [2, 3, 5, 7, 11]"
