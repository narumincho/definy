      "description": [
        {
          "language": "en",
          "text": "Pattern match sample: unwrap some(100) and add 23"
        },
        {
          "language": "ja",
          "text": "パターンマッチのサンプル: some(100) を分解して 23 を加算 (結果: 123)"
