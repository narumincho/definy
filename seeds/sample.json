      "part_type": "type",
      "description": [
        {
          "language": "en",
          "text": "Option type for numbers (none or some(number))"
        },
        {
          "language": "ja",
          "text": "数値用の Option 型 (none または some(number))"
        }
      ],
      "expression": {
        "TypeUnion": {
          "variants": [
            {
              "tag": "none",
              "payload_type": null
            },
            {
              "tag": "some",
              "payload_type": "TypeNumber"
            }
          ]
        }
      }
    },
