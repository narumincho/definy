{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModuleSeed",
  "description": "Seed データファイル（JSON / YAML）用のモジュール表現。 バージョン管理・ブートストラップ用の静的定義データ。",
  "type": "object",
  "required": [
    "module_name",
    "parts"
  ],
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "default": "",
      "type": "string"
    },
    "module_description": {
      "default": "",
      "allOf": [
        {
          "$ref": "#/definitions/Description"
        }
      ]
    },
    "module_name": {
      "type": "string"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ModulePartEntry"
      }
    }
  },
  "definitions": {
    "BooleanExpression": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "boolean"
        }
      }
    },
    "CallArgument": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "CallExpression": {
      "type": "object",
      "required": [
        "arguments",
        "function"
      ],
      "properties": {
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CallArgument"
          }
        },
        "function": {
          "$ref": "#/definitions/Callee"
        }
      }
    },
    "CompilerBuiltin": {
      "type": "string",
      "enum": [
        "let",
        "plus",
        "minus",
        "multiply",
        "divide",
        "remainder",
        "less_than",
        "less_than_or_equal",
        "greater_than",
        "greater_than_or_equal",
        "equal",
        "not_equal",
        "not",
        "and",
        "or",
        "string_concat",
        "string_length",
        "string_slice",
        "string_to_bytes",
        "list_length",
        "list_concat",
        "list_get",
        "list_append",
        "number_literal",
        "function",
        "call",
        "bit_and",
        "bit_or",
        "bit_xor",
        "shift_left",
        "shift_right"
      ]
    },
    "ContentHash": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      },
      "maxItems": 32,
      "minItems": 32
    },
    "Description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LocalizedText"
          }
        }
      ]
    },
    "EventHashId": {
      "anyOf": [
        {
          "description": "ビルトインパーツへの名前参照 (`module.part-name`)。読み込み時にシステムアカウントから ID を導出する",
          "type": "object",
          "required": [
            "$part"
          ],
          "properties": {
            "$part": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          },
          "maxItems": 32,
          "minItems": 32
        }
      ]
    },
    "Expression": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "TypeNumber",
            "TypeString",
            "TypeBoolean",
            "TypeSecret"
          ]
        },
        {
          "type": "object",
          "required": [
            "Number"
          ],
          "properties": {
            "Number": {
              "$ref": "#/definitions/NumberExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "String"
          ],
          "properties": {
            "String": {
              "$ref": "#/definitions/StringExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "TypeList"
          ],
          "properties": {
            "TypeList": {
              "$ref": "#/definitions/TypeListExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ListLiteral"
          ],
          "properties": {
            "ListLiteral": {
              "$ref": "#/definitions/ListLiteralExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "PartReference"
          ],
          "properties": {
            "PartReference": {
              "$ref": "#/definitions/PartReferenceExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Boolean"
          ],
          "properties": {
            "Boolean": {
              "$ref": "#/definitions/BooleanExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Let"
          ],
          "properties": {
            "Let": {
              "$ref": "#/definitions/LetExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Variable"
          ],
          "properties": {
            "Variable": {
              "$ref": "#/definitions/VariableExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "TypeLiteral"
          ],
          "properties": {
            "TypeLiteral": {
              "$ref": "#/definitions/TypeLiteralExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "RecordGet"
          ],
          "properties": {
            "RecordGet": {
              "$ref": "#/definitions/RecordGetExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Function"
          ],
          "properties": {
            "Function": {
              "$ref": "#/definitions/FunctionExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Call"
          ],
          "properties": {
            "Call": {
              "$ref": "#/definitions/CallExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "TypeFunction"
          ],
          "properties": {
            "TypeFunction": {
              "$ref": "#/definitions/TypeFunctionExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "TypeUnion"
          ],
          "properties": {
            "TypeUnion": {
              "$ref": "#/definitions/TypeUnionExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Variant"
          ],
          "properties": {
            "Variant": {
              "$ref": "#/definitions/VariantExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Match"
          ],
          "properties": {
            "Match": {
              "$ref": "#/definitions/MatchExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Compiler"
          ],
          "properties": {
            "Compiler": {
              "$ref": "#/definitions/CompilerBuiltin"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "コードそのものを値にする式 (quote). 型は Code<中の式の型>",
          "type": "object",
          "required": [
            "Quote"
          ],
          "properties": {
            "Quote": {
              "$ref": "#/definitions/QuoteExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "シークレットリテラル. 型は Secret で, 値 (API トークンなど) はパーツに入れず, ブラウザにだけ保存して allowed_url_prefixes の宛先にだけ送る",
          "type": "object",
          "required": [
            "Secret"
          ],
          "properties": {
            "Secret": {
              "$ref": "#/definitions/SecretExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "未入力の式. エディタで式を消したときに入る. 評価・コンパイルはエラーになる",
          "type": "string",
          "enum": [
            "Hole"
          ]
        }
      ]
    },
    "FunctionExpression": {
      "type": "object",
      "required": [
        "body",
        "parameters"
      ],
      "properties": {
        "body": {
          "$ref": "#/definitions/Expression"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FunctionParameter"
          }
        }
      }
    },
    "FunctionParameter": {
      "type": "object",
      "required": [
        "parameter_id",
        "parameter_name"
      ],
      "properties": {
        "parameter_id": {
          "type": "integer",
          "format": "int64"
        },
        "parameter_name": {
          "type": "string"
        }
      }
    },
    "FunctionParameterType": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/PartType"
        }
      }
    },
    "LetBinding": {
      "type": "object",
      "required": [
        "value",
        "variable_id",
        "variable_name"
      ],
      "properties": {
        "value": {
          "$ref": "#/definitions/Expression"
        },
        "variable_id": {
          "type": "integer",
          "format": "int64"
        },
        "variable_name": {
          "type": "string"
        }
      }
    },
    "LetExpression": {
      "type": "object",
      "required": [
        "bindings",
        "body"
      ],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LetBinding"
          }
        },
        "body": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "ListLiteralExpression": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Expression"
          }
        }
      }
    },
    "LocalizedText": {
      "type": "object",
      "required": [
        "language",
        "text"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "MatchArm": {
      "type": "object",
      "required": [
        "body",
        "tag"
      ],
      "properties": {
        "body": {
          "$ref": "#/definitions/Expression"
        },
        "tag": {
          "type": "string"
        },
        "variable_id": {
          "default": null,
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "variable_name": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "MatchExpression": {
      "type": "object",
      "required": [
        "arms",
        "target"
      ],
      "properties": {
        "arms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MatchArm"
          }
        },
        "default": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "ModulePartEntry": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContentHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "$ref": "#/definitions/Description"
        },
        "expression": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "part_type": {
          "anyOf": [
            {
              "$ref": "#/definitions/PartType"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NumberExpression": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "PartReferenceExpression": {
      "type": "object",
      "required": [
        "part_definition_event_hash"
      ],
      "properties": {
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContentHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "part_definition_event_hash": {
          "$ref": "#/definitions/EventHashId"
        }
      }
    },
    "PartType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "number",
            "string",
            "boolean",
            "type",
            "secret"
          ]
        },
        {
          "type": "object",
          "required": [
            "type_part"
          ],
          "properties": {
            "type_part": {
              "$ref": "#/definitions/EventHashId"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "list"
          ],
          "properties": {
            "list": {
              "$ref": "#/definitions/PartType"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "function"
          ],
          "properties": {
            "function": {
              "type": "object",
              "required": [
                "parameters",
                "return_type"
              ],
              "properties": {
                "parameters": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/FunctionParameterType"
                  }
                },
                "return_type": {
                  "$ref": "#/definitions/PartType"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "record"
          ],
          "properties": {
            "record": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/RecordFieldType"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "union"
          ],
          "properties": {
            "union": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/UnionVariantType"
              }
            }
          },
          "additionalProperties": false
        },
        {
          "description": "コードそのものの型 Code<T>. 値は quote 式で作る",
          "type": "object",
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "$ref": "#/definitions/PartType"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "RecordFieldType": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/PartType"
        }
      }
    },
    "RecordGetExpression": {
      "type": "object",
      "required": [
        "key",
        "record"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "record": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "StringExpression": {
      "type": "object",
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "description": "パーツ ID の文字列 (URL-safe Base64) に置き換わるプレースホルダー",
              "type": "object",
              "required": [
                "$partId"
              ],
              "properties": {
                "$partId": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "TypeFunctionExpression": {
      "type": "object",
      "required": [
        "parameters",
        "return_type"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TypeFunctionParameter"
          }
        },
        "return_type": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "TypeFunctionParameter": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "TypeListExpression": {
      "type": "object",
      "required": [
        "item_type"
      ],
      "properties": {
        "item_type": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "TypeLiteralExpression": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TypeLiteralItemExpression"
          }
        }
      }
    },
    "TypeLiteralItemExpression": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "TypeUnionExpression": {
      "type": "object",
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TypeUnionVariant"
          }
        }
      }
    },
    "TypeUnionVariant": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "payload_type": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "UnionVariantType": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "payload": {
          "anyOf": [
            {
              "$ref": "#/definitions/PartType"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "VariableExpression": {
      "type": "object",
      "required": [
        "variable_id"
      ],
      "properties": {
        "variable_id": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "VariantExpression": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "payload": {
          "anyOf": [
            {
              "$ref": "#/definitions/Expression"
            },
            {
              "type": "null"
            }
          ]
        },
        "tag": {
          "type": "string"
        },
        "type_part_definition_event_hash": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/definitions/EventHashId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Callee": {
      "description": "呼び出す関数. 関数は値として書けず呼び出すだけなので, 呼べるのはパーツ (PartReference), 関数型の引数 (Variable), レコードの関数のフィールド (RecordGet) だけ",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "PartReference"
          ],
          "properties": {
            "PartReference": {
              "$ref": "#/definitions/PartReferenceExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Variable"
          ],
          "properties": {
            "Variable": {
              "$ref": "#/definitions/VariableExpression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "RecordGet"
          ],
          "properties": {
            "RecordGet": {
              "$ref": "#/definitions/RecordGetExpression"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "QuoteExpression": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "$ref": "#/definitions/Expression"
        }
      }
    },
    "SecretExpression": {
      "type": "object",
      "required": [
        "id",
        "label",
        "allowed_url_prefixes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "シークレットを区別する ID. 作るときにランダムに決める"
        },
        "label": {
          "type": "string",
          "description": "値を入れるときに出す名前"
        },
        "allowed_url_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "値を送ってよい URL の先頭"
        }
      },
      "additionalProperties": false
    }
  }
}
